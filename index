/* micrófono dentro de la conversación */
let chatRec = null, listening = false;
function toggleListen(){
  if(listening){ chatRec && chatRec.stop(); return; }
  if(!SR){ $('liveTx').textContent = "Este navegador no reconoce voz. Abrilo en Chrome."; return; }
  if(TTS) TTS.cancel();
  chatRec = new SR();
  chatRec.lang='en-US'; chatRec.continuous=true; chatRec.interimResults=true;
  let finalTxt='';
  $('liveTx').textContent=''; $('micChat').dataset.on='1';
  $('micChat').classList.add('rec'); listening=true;
  chatRec.onresult = e=>{
    let interim='';
    for(let i=e.resultIndex;i<e.results.length;i++){
      const r=e.results[i];
      if(r.isFinal) finalTxt += r[0].transcript+' '; else interim += r[0].transcript;
    }
    $('liveTx').textContent = (finalTxt+interim).trim();
  };
  chatRec.onerror = e=>{
    $('liveTx').textContent = e.error==='not-allowed'
      ? (micEnv()==="iframe"
         ? "Abrí la app en una pestaña propia: acá el navegador bloquea el micrófono."
         : "El navegador bloqueó el micrófono. Habilitalo en el candado de la barra de direcciones.")
      : e.error==='network' ? "Este navegador no llega al servicio de voz. Pasa en Brave y en algunos Edge: abrila en Chrome."
      : e.error==='no-speech' ? "No se escuchó nada. Probá de nuevo, más cerca."
      : "Se cortó el micrófono ("+e.error+").";
  };
  chatRec.onend = ()=>{
    listening=false; $('micChat').dataset.on='0'; $('micChat').classList.remove('rec');
    const said = finalTxt.trim();
    if(said){
      $('chatIn').value = said;
      if($('autoSend').checked) sendTurn();
    }
  };
  chatRec.start();
}
$('micChat').onclick = toggleListen;

$('startChat').onclick = async ()=>{
  if(!scenario){ alert("Elegí una situación primero."); return; }
  history=[]; $('chatLog').innerHTML=''; $('chatFeedback').innerHTML='';
  $('chatCard').style.display='block'; $('endChat').disabled=false;
  $('startChat').textContent='Reiniciar';
  const t=document.createElement('div'); t.className='typing'; t.textContent='conectando...';
  $('chatLog').appendChild(t);
