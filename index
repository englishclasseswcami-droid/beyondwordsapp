   1 · CONVERSAR
   ============================================================ */
const SCENARIOS = [
  {k:"update",   t:"Dar el update del proyecto frente al PM"},
  {k:"cut",      t:"Te interrumpen y tenés que retomar"},
  {k:"fast",     t:"Cliente que habla rápido"},
  {k:"qa",       t:"Preguntas después de tu presentación"},
  {k:"deadline", t:"Negociar una fecha de entrega"},
  {k:"smalltalk",t:"Los cinco minutos antes de que arranque la call"},
  {k:"pushback", t:"Alguien no está de acuerdo con tu propuesta"}
];
let scenario = null, history = [];
const $ = id => document.getElementById(id);

const chipBox = $('scenarios');
SCENARIOS.forEach(s=>{
  const b = document.createElement('button');
  b.className='chip'; b.textContent=s.t; b.setAttribute('aria-pressed','false');
