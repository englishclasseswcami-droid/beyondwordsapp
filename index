   ============================================================ */
const TRAITS = {
  "Sonidos":["schwa /ə/","/iː/ vs /ɪ/","/æ/ vs /e/","th /θ ð/","/v/ vs /b/","/s/ vs /z/","h inicial","consonantes finales","grupos consonánticos","-ed final"],
  "Habla conectada":["no une palabras","reductions","elisión","silabea (ritmo parejo)","habla demasiado rápido"],
  "Prosodia":["word stress","el peso cae siempre al final","no agrupa en thought groups","pausas en lugares raros","entonación plana","no marca la intención"],
  "Otros":["mucha duda / relleno","volumen bajo","traduce literal del español","se corta y reinicia"]
};
const tBox=$('traits');
Object.entries(TRAITS).forEach(([group,items])=>{
  const h=document.createElement('h4'); h.textContent=group; tBox.appendChild(h);
  const row=document.createElement('div'); row.className='chips';
  items.forEach(it=>{
    const b=document.createElement('button');
    b.className='chip'; b.textContent=it; b.setAttribute('aria-pressed','false');
    b.onclick=()=>b.setAttribute('aria-pressed', b.getAttribute('aria-pressed')==='true'?'false':'true');
    row.appendChild(b);
  });
  tBox.appendChild(row);
});

