};
async function sendTurn(){
  const v=$('chatIn').value.trim(); if(!v) return;
  $('chatIn').value=''; $('liveTx').textContent='';
  bubble("vos",v,"me"); history.push({role:"user",content:v});
  const t=document.createElement('div'); t.className='typing'; t.textContent='escribiendo...';
  $('chatLog').appendChild(t); $('chatLog').scrollTop=$('chatLog').scrollHeight;
  try{
    const rep = await ask(chatSystem(),history);
    t.remove(); botTurn(rep);
  }catch(e){ t.remove(); fail($('chatFeedback'),"Se cortó la respuesta."); }
}
$('sendChat').onclick = sendTurn;
$('chatIn').addEventListener('keydown',e=>{
  if(e.key==="Enter" && !e.shiftKey){ e.preventDefault(); sendTurn(); }
