function chatSystem(){
  return `You are a native English-speaking professional in this workplace situation: "${scenario}".
The other person's context: ${$('ctx').value || "a professional working with a US head office"}.

Rules:
- Stay in role. You are a colleague, client or manager — never a teacher.
- Speak natural, unsimplified professional English. Do not slow down or dumb it down.
- NEVER correct grammar, vocabulary or phrasing. Never comment on their English. Never switch to Spanish.
- Keep every turn to 1-3 sentences. Real people are brief.
- Drive the conversation: ask follow-ups, push back, add time pressure, ask for specifics.
- Occasionally ask them to clarify ONLY when their message is genuinely ambiguous.
- Start with one short opening line that drops them straight into the moment.`;
}
function bubble(who,txt,cls){
  const d=document.createElement('div'); d.className='msg '+cls;
  d.innerHTML='<span class="who">'+who+'</span>'+txt.replace(/</g,"&lt;");
  $('chatLog').appendChild(d); $('chatLog').scrollTop=$('chatLog').scrollHeight;
}
function botTurn(txt){
  history.push({role:"assistant",content:txt});
  if(voiceOn && $('hideTxt').checked){
    const d=document.createElement('div'); d.className='msg hidden-txt';
    d.innerHTML='🔊 Escuchá <button>ver el texto</button>';
    d.querySelector('button').onclick=()=>{
      d.className='msg them';
      d.innerHTML='<span class="who">them</span>'+txt.replace(/</g,"&lt;");
    };
    $('chatLog').appendChild(d); $('chatLog').scrollTop=$('chatLog').scrollHeight;
  } else {
    bubble("them",txt,"them");
  }
  if(voiceOn) say(txt);
}

/* modo hablando / escribiendo */
let voiceOn = true;
