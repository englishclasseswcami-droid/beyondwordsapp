<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Beyond Words · Práctica</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ground:#EFEDF3;
    --surface:#FFFFFF;
    --surface-2:#F7F5FA;
    --ink:#1E1B2E;
    --muted:#6B6780;
    --line:#DAD6E4;
    --accent:#E0356F;
    --accent-soft:#FCE7EE;
    --signal:#2F8F83;
    --signal-soft:#E2F1EF;
    --warn:#B85C1F;
    --warn-soft:#FBEDE1;
    --display:"Fraunces",Georgia,serif;
    --body:"Instrument Sans",system-ui,-apple-system,sans-serif;
    --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--ground);
    color:var(--ink);
    font-family:var(--body);
    font-size:16px;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:820px;margin:0 auto;padding:0 20px 80px}

  /* ---------- header ---------- */
  header.top{padding:34px 0 22px}
  .eyebrow{
    font-family:var(--mono);font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--muted);margin:0 0 18px
  }
  .hero-line{
    font-family:var(--display);
    font-size:clamp(24px,5.2vw,38px);
    line-height:1.35;font-weight:600;margin:0 0 10px
  }
  .hero-sub{color:var(--muted);margin:0;max-width:52ch}

  /* ---------- prosody rendering (signature) ---------- */
  .prosody{font-family:var(--display);font-weight:600;line-height:2.1}
  .pgroup{display:inline}
  .pbreak{
    display:inline-block;width:1px;height:.95em;background:var(--line);
    margin:0 .55em;vertical-align:-.12em
  }
  .prom{
    color:var(--accent);position:relative;padding:0 .04em;
  }
  .prom::before{
    content:"";position:absolute;top:-.42em;left:50%;transform:translateX(-50%);
    width:6px;height:6px;border-radius:50%;background:var(--accent)
  }
  .link-arc{color:var(--accent);opacity:.55;font-size:.9em;padding:0 .02em}

  /* ---------- tabs ---------- */
  nav.tabs{
    display:flex;gap:4px;overflow-x:auto;padding:4px;margin:26px 0 20px;
    background:var(--surface);border:1px solid var(--line);border-radius:14px;
    scrollbar-width:none
  }
  nav.tabs::-webkit-scrollbar{display:none}
  nav.tabs button{
    flex:0 0 auto;border:0;background:transparent;color:var(--muted);
    font-family:var(--body);font-size:14px;font-weight:500;
    padding:9px 14px;border-radius:10px;cursor:pointer;white-space:nowrap
  }
  nav.tabs button:hover{color:var(--ink);background:var(--surface-2)}
  nav.tabs button[aria-selected="true"]{background:var(--ink);color:#fff}
  nav.tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  /* ---------- panels & cards ---------- */
  .panel{display:none}
  .panel.on{display:block}
  .card{
    background:var(--surface);border:1px solid var(--line);
    border-radius:16px;padding:22px;margin-bottom:16px
  }
  .card h2{
    font-family:var(--display);font-size:21px;font-weight:600;
    margin:0 0 6px;line-height:1.3
  }
  .card p.lede{color:var(--muted);margin:0 0 18px;font-size:14.5px}
  .label{
    display:block;font-family:var(--mono);font-size:11px;letter-spacing:.12em;
    text-transform:uppercase;color:var(--muted);margin:0 0 8px
  }
  .hint{font-size:13px;color:var(--muted);margin:10px 0 0}

  /* ---------- controls ---------- */
  input[type=text],textarea,select{
    width:100%;font-family:var(--body);font-size:15px;color:var(--ink);
    background:var(--surface-2);border:1px solid var(--line);
    border-radius:11px;padding:11px 13px
  }
  textarea{resize:vertical;min-height:90px;line-height:1.5}
  input:focus,textarea:focus,select:focus{
    outline:2px solid var(--accent);outline-offset:1px;background:var(--surface)
  }
  .btn{
    font-family:var(--body);font-size:14.5px;font-weight:600;
    border:0;border-radius:11px;padding:11px 18px;cursor:pointer;
    background:var(--ink);color:#fff
  }
  .btn:hover{background:#332E4A}
  .btn:disabled{opacity:.4;cursor:not-allowed}
  .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
  .btn.ghost:hover{background:var(--surface-2)}
  .btn.pink{background:var(--accent)}
  .btn.pink:hover{background:#C82A60}
  .btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .row{display:flex;gap:9px;flex-wrap:wrap;align-items:center}
  .row.end{justify-content:flex-end}

  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
  .chip{
    border:1px solid var(--line);background:var(--surface-2);color:var(--ink);
    font-family:var(--body);font-size:13.5px;padding:8px 13px;
    border-radius:999px;cursor:pointer;text-align:left
  }
  .chip:hover{border-color:var(--ink)}
  .chip[aria-pressed="true"]{background:var(--ink);color:#fff;border-color:var(--ink)}
  .chip:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  /* ---------- chat ---------- */
  #chatLog{
    display:flex;flex-direction:column;gap:12px;
    max-height:380px;overflow-y:auto;padding:4px 2px 8px;margin-bottom:14px
  }
  .msg{max-width:82%;padding:11px 14px;border-radius:14px;font-size:15px;line-height:1.5}
  .msg.them{background:var(--surface-2);border:1px solid var(--line);align-self:flex-start;border-bottom-left-radius:5px}
  .msg.me{background:var(--ink);color:#fff;align-self:flex-end;border-bottom-right-radius:5px}
  .msg .who{
    display:block;font-family:var(--mono);font-size:10px;letter-spacing:.1em;
    text-transform:uppercase;opacity:.55;margin-bottom:4px
  }
  .typing{font-family:var(--mono);font-size:12px;color:var(--muted);padding:4px 2px}

  /* ---------- results ---------- */
  .result{
    background:var(--surface-2);border:1px solid var(--line);
    border-radius:13px;padding:17px;margin-top:16px
  }
  .result h3{
    font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--muted);margin:0 0 7px;font-weight:500
  }
  .result h3+p{margin:0 0 16px}
  .result p:last-child{margin-bottom:0}
  .heard{font-family:var(--mono);font-size:14px;line-height:2}
  .ok{color:var(--signal);background:var(--signal-soft);border-radius:4px;padding:2px 4px}
  .lost{color:var(--warn);background:var(--warn-soft);border-radius:4px;padding:2px 4px;text-decoration:underline wavy}

  /* ---------- coach traits ---------- */
  .traits{margin-bottom:18px}
  .traits h4{
    font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--muted);font-weight:500;margin:16px 0 9px
  }
  .traits h4:first-child{margin-top:0}
  .out{
    white-space:pre-wrap;font-size:15px;line-height:1.65;
    background:var(--surface);border:1px solid var(--line);
    border-radius:13px;padding:17px;margin-top:14px
  }
  .err{color:var(--warn);font-size:14px;margin-top:12px}
  .note{
    font-size:13px;color:var(--muted);border-left:2px solid var(--line);
    padding-left:12px;margin:14px 0 0
  }
  footer{text-align:center;color:var(--muted);font-size:12.5px;padding:30px 0 0}

  /* ---------- voz ---------- */
  .modes{
    display:inline-flex;gap:3px;background:var(--surface-2);
    border:1px solid var(--line);border-radius:11px;padding:3px;margin-bottom:16px
  }
  .modes button{
    border:0;background:transparent;font-family:var(--body);font-size:13.5px;
    font-weight:500;color:var(--muted);padding:7px 15px;border-radius:9px;cursor:pointer
  }
  .modes button[aria-pressed="true"]{background:var(--ink);color:#fff}
  .modes button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .voicebar{
    display:flex;gap:13px;align-items:center;padding:15px;margin-bottom:13px;
    background:var(--surface-2);border:1px solid var(--line);border-radius:13px
  }
  .micbig{
    flex:0 0 auto;width:56px;height:56px;border-radius:50%;border:0;cursor:pointer;
    background:var(--accent);color:#fff;font-size:22px;line-height:1;
    display:flex;align-items:center;justify-content:center
  }
  .micbig[data-on="1"]{background:var(--ink)}
  .micbig:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
  .live{flex:1;min-width:0;font-size:15px;line-height:1.45;color:var(--ink)}
  .live:empty::before{content:"Tocá el micrófono y hablá";color:var(--muted)}
  .vopts{display:flex;gap:16px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--muted)}
  .vopts label{display:flex;gap:6px;align-items:center;cursor:pointer}
  .vopts select{width:auto;font-size:13px;padding:5px 8px}
  .hidden-txt{
    background:var(--surface-2);border:1px dashed var(--line);align-self:flex-start;
    border-radius:14px;padding:11px 14px;font-size:14px;color:var(--muted)
  }
  .hidden-txt button{
    border:0;background:transparent;color:var(--accent);font-family:var(--body);
    font-size:13px;font-weight:600;cursor:pointer;padding:0;margin-left:8px
  }
  .banner{
    display:none;background:var(--warn-soft);border:1px solid #E8CBAF;
    border-radius:13px;padding:14px 16px;margin-bottom:16px;font-size:14px;line-height:1.5
  }
  .banner.on{display:block}
  .banner strong{display:block;margin-bottom:3px}
  .banner a{color:var(--warn);font-weight:600}
  @media (prefers-reduced-motion:no-preference){
    .rec{animation:pulse 1.3s ease-in-out infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
  }
  @media(max-width:520px){
    .card{padding:18px}
    .msg{max-width:92%}
  }
</style>
</head>
<body>
<div class="wrap">

<header class="top">
  <p class="eyebrow">Beyond Words · práctica entre asesorías</p>
  <div class="hero-line prosody" id="heroLine"></div>
  <p class="hero-sub">Entrená acá durante la semana. Lo que no te salga, lo llevás a la asesoría.</p>
</header>

<nav class="tabs" role="tablist">
  <button role="tab" aria-selected="true" data-p="conv">Conversar</button>
  <button role="tab" aria-selected="false" data-p="int">Escuchar la intención</button>
  <button role="tab" aria-selected="false" data-p="say">Decirlo en voz alta</button>
  <button role="tab" aria-selected="false" data-p="send">Enviar un audio</button>
  <button role="tab" aria-selected="false" data-p="coach">Modo coach</button>
</nav>

<div class="banner" id="micBanner"></div>

<!-- ============ CONVERSAR ============ -->
<section class="panel on" id="p-conv">
  <div class="card">
    <h2>Conversar sin guionar</h2>
    <p class="lede">Elegí la situación. Vas a hablar con alguien que no se frena a corregirte: sostiene la conversación y espera tu respuesta. No lo pienses de más — es el punto.</p>
    <div class="modes" role="group" aria-label="Modo de práctica">
      <button id="mVoice" aria-pressed="true">Hablando</button>
      <button id="mText" aria-pressed="false">Escribiendo</button>
    </div>
    <div class="vopts" id="voiceOpts" style="margin-bottom:16px">
      <label for="rate">Velocidad
        <select id="rate">
          <option value="0.9">tranquila</option>
          <option value="1" selected>normal</option>
          <option value="1.15">rápida</option>
        </select>
      </label>
      <label><input type="checkbox" id="hideTxt"> Escuchar sin leer</label>
      <label><input type="checkbox" id="autoSend" checked> Enviar al terminar de hablar</label>
    </div>
    <div class="chips" id="scenarios"></div>
    <label class="label" for="ctx">Tu contexto (opcional)</label>
    <input type="text" id="ctx" placeholder="Ej: soy PM en una empresa de logística, HQ en Chicago">
    <div class="row" style="margin-top:14px">
      <button class="btn" id="startChat">Empezar</button>
      <button class="btn ghost" id="endChat" disabled>Terminar y ver devolución</button>
    </div>
  </div>

  <div class="card" id="chatCard" style="display:none">
    <div id="chatLog"></div>
    <div class="voicebar" id="voiceBar">
      <button class="micbig" id="micChat" data-on="0" aria-label="Hablar">🎙</button>
      <p class="live" id="liveTx"></p>
    </div>
    <label class="label" for="chatIn">Tu respuesta</label>
    <textarea id="chatIn" placeholder="Escribí en inglés..."></textarea>
    <div class="row end" style="margin-top:10px">
      <button class="btn pink" id="sendChat">Enviar</button>
    </div>
    <p class="note">Lo que ves escrito es lo que el navegador te <em>escuchó</em>. Si aparece una palabra que no dijiste, ahí hay algo que no está llegando. La devolución mira cómo armaste el mensaje, no cómo sonó: para el sonido, mandale el audio a Cami.</p>
    <div id="chatFeedback"></div>
  </div>
</section>

<!-- ============ INTENCIÓN ============ -->
<section class="panel" id="p-int">
  <div class="card">
    <h2>La misma frase, otra intención</h2>
    <p class="lede">Una frase de trabajo. Según dónde cae el peso, quiere decir otra cosa. Entrenás el oído para escuchar lo que hay atrás del mensaje.</p>
    <div class="row">
      <button class="btn" id="newDrill">Dame una frase</button>
    </div>
    <div id="drillArea"></div>
  </div>
</section>

<!-- ============ DECIRLO ============ -->
<section class="panel" id="p-say">
  <div class="card">
    <h2>Marcá la frase y decila</h2>
    <p class="lede">Escribí la frase que necesitás decir esta semana. Te la devuelvo marcada: dónde cortar, qué palabra lleva el peso y qué se une con qué.</p>
    <label class="label" for="sayIn">Tu frase en inglés</label>
    <input type="text" id="sayIn" placeholder="I'd like to go back to what you mentioned earlier">
    <div class="row" style="margin-top:12px">
      <button class="btn" id="markBtn">Marcar la frase</button>
    </div>
    <div id="markArea"></div>
  </div>

  <div class="card">
    <h2>Probá si se entiende</h2>
    <p class="lede">Decí la frase en voz alta con el micrófono abierto. El navegador escribe lo que escuchó. Si escuchó otra cosa, ahí hay algo que trabajar.</p>
    <p class="note" style="margin-top:0">No mide si sonás nativa. Mide si el mensaje llega. Funciona en Chrome, con micrófono habilitado.</p>
    <div class="row" style="margin-top:14px">
      <button class="btn pink" id="micBtn" disabled>Marcá una frase primero</button>
    </div>
    <div id="micArea"></div>
  </div>
</section>

<!-- ============ ENVIAR AUDIO ============ -->
<section class="panel" id="p-send">
  <div class="card">
    <h2>Mandale el audio a Cami</h2>
    <p class="lede">Grabá el audio con tu celular y mandalo por WhatsApp. Completá esto primero: lo copiás y lo mandás junto con el audio, así ella escucha sabiendo qué buscabas.</p>
    <label class="label" for="sTarget">Qué estabas practicando</label>
    <input type="text" id="sTarget" placeholder="La frase, el párrafo o la situación">
    <label class="label" for="sHard" style="margin-top:16px">Qué te costó</label>
    <textarea id="sHard" placeholder="Ej: se me traba la parte del medio, no sé dónde cortar"></textarea>
    <label class="label" for="sTest" style="margin-top:16px">Resultado del test de micrófono (si lo hiciste)</label>
    <input type="text" id="sTest" placeholder="Ej: escuchó 'ship' donde dije 'sheep'">
    <div class="row" style="margin-top:14px">
      <button class="btn" id="buildCard">Armar el mensaje</button>
    </div>
    <div id="sendArea"></div>
  </div>
</section>

<!-- ============ COACH ============ -->
<section class="panel" id="p-coach">
  <div class="card">
    <h2>Devolución de un audio</h2>
    <p class="lede">Escuchá el audio una vez y marcá lo que oíste. La devolución sale escrita, lista para copiar y mandar.</p>

    <label class="label" for="cWho">Alumna y contexto</label>
    <input type="text" id="cWho" placeholder="Ej: Sofía · practicaba el update semanal">

    <label class="label" for="cTarget" style="margin-top:16px">Qué estaba diciendo</label>
    <textarea id="cTarget" placeholder="Pegá acá el mensaje que te mandó, o escribí la frase que grabó"></textarea>

    <div class="traits" id="traits" style="margin-top:18px"></div>

    <label class="label" for="cNotes">Lo que escuchaste, en tus palabras</label>
    <textarea id="cNotes" placeholder="Ej: arranca bien pero corta después de cada palabra, no agrupa. El peso siempre cae en la última palabra."></textarea>

    <div class="row" style="margin-top:14px">
      <button class="btn pink" id="genFb">Escribir la devolución</button>
      <button class="btn ghost" id="clearFb">Limpiar</button>
    </div>
    <div id="coachArea"></div>
  </div>
</section>

<footer>Beyond Words · el cómo importa más que el qué</footer>
</div>

<script>
/* ============================================================
   Marcado prosódico
   //   corte de thought group
   *x*  palabra que lleva el peso
   a~b  linking
   ============================================================ */
function renderProsody(txt){
  const esc = s => s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  return txt.split("//").map(g=>{
    let h = esc(g.trim());
    h = h.replace(/\*(.+?)\*/g,'<span class="prom">$1</span>');
    h = h.replace(/(\S)~(\S)/g,'$1<span class="link-arc">‿</span>$2');
    return '<span class="pgroup">'+h+'</span>';
  }).join('<span class="pbreak"></span>');
}
document.getElementById('heroLine').innerHTML =
  renderProsody("You already have the *expertise* // make~it *audible* in English");

/* ============================================================
   API
   ============================================================ */
async function ask(system, messages){
  const r = await fetch("https://api.anthropic.com/v1/messages",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
      model:"claude-sonnet-4-6",
      max_tokens:1000,
      system:system,
      messages:messages
    })
  });
  if(!r.ok) throw new Error("status "+r.status);
  const d = await r.json();
  return (d.content||[]).filter(b=>b.type==="text").map(b=>b.text).join("\n").trim();
}
function parseJSON(t){
  const clean = t.replace(/```json|```/g,"").trim();
  const s = clean.indexOf("{"), e = clean.lastIndexOf("}");
  return JSON.parse(s>=0 ? clean.slice(s,e+1) : clean);
}
function fail(el,msg){
  el.innerHTML = '<p class="err">'+msg+' Probá de nuevo en un momento.</p>';
}

/* ============================================================
   Tabs
   ============================================================ */
document.querySelectorAll('nav.tabs button').forEach(b=>{
  b.onclick = ()=>{
    document.querySelectorAll('nav.tabs button').forEach(x=>x.setAttribute('aria-selected','false'));
    b.setAttribute('aria-selected','true');
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('on'));
    document.getElementById('p-'+b.dataset.p).classList.add('on');
  };
});

/* ============================================================
   Voz: escuchar (SpeechRecognition) y hablar (SpeechSynthesis)
   ============================================================ */
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
const TTS = window.speechSynthesis || null;
let enVoice = null;
function pickVoice(){
  if(!TTS) return;
  const vs = TTS.getVoices().filter(v=>/^en[-_]/i.test(v.lang));
  enVoice = vs.find(v=>/en[-_]US/i.test(v.lang) && /Google|Natural|Samantha|Aaron|Ava/i.test(v.name))
         || vs.find(v=>/en[-_]US/i.test(v.lang))
         || vs[0] || null;
}
if(TTS){ pickVoice(); TTS.onvoiceschanged = pickVoice; }
function say(text, done){
  if(!TTS){ done && done(); return; }
  TTS.cancel();
  const u = new SpeechSynthesisUtterance(text);
  if(enVoice) u.voice = enVoice;
  u.lang = enVoice ? enVoice.lang : 'en-US';
  u.rate = parseFloat(document.getElementById('rate').value) || 1;
  u.onend = ()=> done && done();
  u.onerror = ()=> done && done();
  TTS.speak(u);
}

/* por qué el micrófono puede no andar */
const MIC_MSG = {
  iframe:'<strong>El micrófono está bloqueado acá.</strong>Estás viendo la app dentro de otra página, y el navegador no le da micrófono a una página embebida. Abrila en una pestaña propia y anda. Mientras tanto podés usar el modo Escribiendo.',
  insecure:'<strong>El micrófono está bloqueado acá.</strong>El navegador solo lo habilita en páginas seguras. Si abriste el archivo desde tu computadora, subilo a un sitio con https y entrá desde ahí.',
  browser:'<strong>Este navegador no reconoce voz.</strong>Abrí la app en Chrome para practicar hablando. En el resto, la app funciona en modo Escribiendo.',
  brave:'<strong>Brave no reconoce voz.</strong>Deja el botón a la vista pero nunca devuelve lo que decís. Abrí la app en Chrome para practicar hablando.'
};
function micEnv(){
  if(!SR) return "browser";
  if(!window.isSecureContext) return "insecure";
  try{ if(window.self !== window.top) return "iframe"; }catch(e){ return "iframe"; }
  if(braveDetected) return "brave";
  return "ok";
}
let braveDetected = false;
function paintBanner(){
  const b=document.getElementById('micBanner'), env=micEnv();
  if(env==="ok"){ b.classList.remove('on'); return; }
  b.innerHTML = MIC_MSG[env] + (env==="iframe"
    ? ' <a href="'+location.href+'" target="_blank" rel="noopener">Abrir en una pestaña nueva</a>' : '');
  b.classList.add('on');
}
paintBanner();
