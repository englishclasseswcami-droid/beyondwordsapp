$('micBtn').onclick = ()=>{
  const box=$('micArea');
  if(!SR){
    box.innerHTML='<p class="err">Este navegador no reconoce voz. Abrilo en Chrome para usar el test.</p>';
    return;
  }
  const rec=new SR();
  rec.lang='en-US'; rec.interimResults=false; rec.maxAlternatives=1;
  $('micBtn').textContent='Escuchando...'; $('micBtn').classList.add('rec'); $('micBtn').disabled=true;
  box.innerHTML='<p class="typing">decí la frase completa, de corrido</p>';
  rec.onresult = e=>{
    const heard = e.results[0][0].transcript;
    box.innerHTML = compare(targetPhrase, heard);
  };
  rec.onerror = e=>{
    const m = e.error==='not-allowed'
      ? (micEnv()==="iframe"
         ? 'El navegador bloquea el micrófono en páginas embebidas. Abrí la app en una pestaña propia.'
         : 'El navegador bloqueó el micrófono. Habilitalo para este sitio en el candado de la barra de direcciones y volvé a intentar.')
      : e.error==='network'
      ? 'Este navegador no llega al servicio de voz. Pasa en Brave y en algunos Edge: abrila en Chrome.'
      : e.error==='no-speech'
      ? 'No se escuchó nada. Acercate al micrófono y decí la frase completa.'
      : 'El micrófono se cortó ('+e.error+').';
    box.innerHTML='<p class="err">'+m+'</p>';
  };
  rec.onend = ()=>{
    $('micBtn').textContent='Decirla otra vez';
    $('micBtn').classList.remove('rec'); $('micBtn').disabled=false;
  };
  rec.start();
};

function norm(w){ return w.toLowerCase().replace(/[^a-z']/g,''); }
function compare(target, heard){
  const T=target.split(/\s+/), H=heard.split(/\s+/);
  const hn=H.map(norm), used=new Array(hn.length).fill(false);
  let lost=0, cursor=0;
  const marked = T.map(w=>{
    const n=norm(w); if(!n) return w;
    let i=-1;
    for(let k=cursor;k<hn.length;k++){ if(!used[k]&&hn[k]===n){ i=k; break; } }
    if(i<0) for(let k=0;k<hn.length;k++){ if(!used[k]&&hn[k]===n){ i=k; break; } }
    if(i>=0){ used[i]=true; cursor=i+1; return '<span class="ok">'+w+'</span>'; }
    lost++; return '<span class="lost">'+w+'</span>';
  }).join(' ');
  const pct = Math.round(100*(T.length-lost)/Math.max(T.length,1));
  const verdict = lost===0
    ? 'Llegó entero. El mensaje se procesa sin esfuerzo.'
    : lost===1
    ? 'Se perdió una palabra. Trabajá esa y la frase queda.'
    : 'Se perdieron '+lost+' palabras. Ahí es donde el que escucha tiene que adivinar.';
  return '<div class="result">'+
    '<h3>Lo que quisiste decir</h3><p class="heard">'+marked+'</p>'+
    '<h3>Lo que escuchó</h3><p class="heard">'+heard.replace(/</g,"&lt;")+'</p>'+
    '<h3>'+pct+'% llegó</h3><p>'+verdict+'</p>'+
    '<p class="note" style="margin-top:14px">El reconocedor a veces adivina por contexto, así que tomalo como termómetro, no como diagnóstico. Si una palabra se pierde siempre, mandale el audio a Cami.</p>'+
    '</div>';
}

